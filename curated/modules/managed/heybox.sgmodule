[Script]
heybox_1 = type=http-response, pattern=^https://api\.xiaoheihe\.cn/(?:bbs/app/feeds/news|account/get_ads_info_v2)(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/828064cfc7c2d7dd910aad27.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% api.xiaoheihe.cn
