#!name=TiebaPure · 维护版
#!desc=保留来源净化功能；修复记录见 managed-manifest.json；需 Egern CA 完全信任
#!author=原作者见来源；tuohai57 维护
# Source: https://cdn.jsdelivr.net/gh/fmz200/wool_scripts@32d808f22bbd0c60ddce168a2319b44c4af57bbd/Surge/module/split/partB/BaiduTieba.sgmodule
# Device acceptance pending; installation alone does not establish effectiveness.

[Script]
tieba_1 = type=http-response, pattern=^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?), script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/442d97a9c007066282705070.js, requires-body=true, timeout=10
tieba_2 = type=http-response, pattern=^(?!(?:(?:^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?))))http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd, script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/acb75416a2dac13fbd25f396.js, requires-body=true, binary-body-mode=true, timeout=10, argument=["0"]

[MITM]
hostname = %APPEND% tiebac.baidu.com
