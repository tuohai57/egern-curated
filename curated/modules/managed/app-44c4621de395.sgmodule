#!name=汽车之家 · 维护版
#!desc=保留来源净化功能；修复记录见 managed-manifest.json；需 Egern CA 完全信任
#!author=原作者见来源；tuohai57 维护
# Source: audited local jq expressions
# Device acceptance pending; installation alone does not establish effectiveness.

[Map Local]
^https://adproxy\.autohome\.com\.cn/AdvertiseService/AppHandler\.ashx(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://pcmx\.autohome\.com\.cn/queryCreativeList(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% adproxy.autohome.com.cn, pcmx.autohome.com.cn
