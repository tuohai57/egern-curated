[Script]
meiyan_1 = type=http-response, pattern=^https://api\.meiyan\.com/operation/(?:get_config|home_banner|home)\.json(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/828064cfc7c2d7dd910aad27.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% api.meiyan.com
