#!name=大麦 · 维护版
#!desc=保留来源净化功能；修复记录见 managed-manifest.json；需 Egern CA 完全信任
#!author=原作者见来源；tuohai57 维护
# Source: audited local jq expressions
# Device acceptance pending; installation alone does not establish effectiveness.

[Body Rewrite]
http-response-jq ^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.user\.my\.content\.get(?:/[^?#]*)?(?:\?[^#]*)?$ '(if type=="object" and (.data|type)=="object" then del(.data.banner) else . end)'

[Map Local]
^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.home\.welcome(?:/[^?#]*)?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.popup\.get(?:/[^?#]*)?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% acs.m.taobao.com
