# Device acceptance pending; installation alone does not establish effectiveness.

[Script]
coolapk_1 = type=http-response, pattern=^https?:\/\/api\.coolapk\.com\/v6\/feed\/(detail|replyList)\?, script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/df37fc59b4f5f0fa8b138290.js, requires-body=true, timeout=60
coolapk_2 = type=http-response, pattern=^(?!(?:(?:^https?:\/\/api\.coolapk\.com\/v6\/feed\/(detail|replyList)\?)))https?:\/\/api\.coolapk\.com\/v6\/main\/(dataList|indexV8|init), script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/df37fc59b4f5f0fa8b138290.js, requires-body=true, timeout=60
coolapk_3 = type=http-response, pattern=^(?!(?:(?:^https?:\/\/api\.coolapk\.com\/v6\/feed\/(detail|replyList)\?)|(?:^https?:\/\/api\.coolapk\.com\/v6\/main\/(dataList|indexV8|init))))https?:\/\/api\.coolapk\.com\/v6\/page\/dataList\?, script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/df37fc59b4f5f0fa8b138290.js, requires-body=true, timeout=60
coolapk_4 = type=http-request, pattern=^https:\/\/www\.coolapk\.com\/link.*, script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/66f2bec19c437dd6b6c0fba7.js, timeout=10

[MITM]
hostname = %APPEND% api.coolapk.com, www.coolapk.com
