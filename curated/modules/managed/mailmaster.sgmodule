#!name=网易邮箱大师 · 维护版
#!desc=保留来源净化功能；修复记录见 managed-manifest.json；需 Egern CA 完全信任
#!author=原作者见来源；tuohai57 维护
# Source: https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/source/rewritten-apps.js
# Device acceptance pending; installation alone does not establish effectiveness.

[Script]
mailmaster_1 = type=http-response, pattern=^https://appconf\.mail\.163\.com/mailmaster/api/(?:page/v2/conf|config/function)\.do(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/tuohai57/egern-curated/main/curated/scripts/managed/828064cfc7c2d7dd910aad27.js, requires-body=true, timeout=10

[URL Rewrite]
^https?://nex\.163\.com/q(?:\?|$) - reject
^https?://g1\.163\.com/madfeedback(?:\?|$) - reject

[MITM]
hostname = %APPEND% appconf.mail.163.com, g1.163.com, nex.163.com
